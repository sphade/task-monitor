# Local Cloudflare Workers dev server (pnpm dev:api at the repo root).
EXPO_PUBLIC_API_URL=http://localhost:8787

# Android emulator uses this instead (host loopback):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8787
# Physical devices need your machine's LAN IP, e.g.:
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8787

# ---------------------------------------------------------------------------
# Feature flags — staged rollout, disable without a redeploy
# ---------------------------------------------------------------------------
# Persistent 1-on-1 chat + realtime delivery over Durable Objects
EXPO_PUBLIC_FEATURE_CHAT=true
# Integrated PRD/SDD documentation repository
EXPO_PUBLIC_FEATURE_DOCS=true
# Kanban board view for tasks
EXPO_PUBLIC_FEATURE_KANBAN=true
