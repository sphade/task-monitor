// Wrangler configuration for the task-monitor API.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "task-monitor",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    // Hourly sweep: flip lapsed tasks to `overdue`.
    "crons": ["0 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "task-monitor-db",
      "database_id": "7812d88d-a58f-43e0-b56e-24223528ba8b",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "6deeec7b77474194b22cc486bf2fae35"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_ROOM",
        "class_name": "ChatRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ChatRoom"]
    }
  ]
}
