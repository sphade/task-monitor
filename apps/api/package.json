{
  "name": "@task-monitor/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "db:migrate": "wrangler d1 migrations apply task-monitor-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply task-monitor-db --remote",
    "db:seed": "wrangler d1 execute task-monitor-db --local --file scripts/seed.sql",
    "db:seed:remote": "wrangler d1 execute task-monitor-db --remote --file scripts/seed.sql"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.5",
    "hono": "^4.9.7",
    "jose": "^6.1.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250823.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.1",
    "better-sqlite3": "^12.2.0",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.35.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.43.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.38.0"
  }
}
